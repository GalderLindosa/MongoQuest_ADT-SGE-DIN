<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.mongoquest.ScheduleWindowController">

    <children>

        <VBox spacing="10" AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10"
              AnchorPane.topAnchor="10"
              AnchorPane.bottomAnchor="10">

            <TableView fx:id="ScheduleTable" prefHeight="350">

                <columns>

                    <TableColumn fx:id="hourColumn"
                                 text="Hour"
                                 prefWidth="80"/>

                    <TableColumn fx:id="mondayColumn"
                                 text="Monday"
                                 prefWidth="100"/>

                    <TableColumn fx:id="tuesdayColumn"
                                 text="Tuesday"
                                 prefWidth="100"/>

                    <TableColumn fx:id="wednesdayColumn"
                                 text="Wednesday"
                                 prefWidth="100"/>

                    <TableColumn fx:id="thursdayColumn"
                                 text="Thursday"
                                 prefWidth="100"/>

                    <TableColumn fx:id="fridayColumn"
                                 text="Friday"
                                 prefWidth="100"/>

                    <TableColumn fx:id="saturdayColumn"
                                 text="Saturday"
                                 prefWidth="100"/>

                    <TableColumn fx:id="sundayColumn"
                                 text="Sunday"
                                 prefWidth="100"/>

                </columns>

            </TableView>

            <HBox spacing="10">

                <Button fx:id="btnCreateClass"
                        text="Create Class"
                        onAction="#createClass"
                        />

                <Button fx:id="btnEditClass"
                        text="Edit Class"
                        onAction="#editClass"/>

                <Button fx:id="btnDeleteClass"
                        text="Delete Class"
                        onAction="#deleteClass"/>

                <Button fx:id="btnUnsubscribe"
                        text="Unsubscribe"
                        onAction="#unsubscribe"/>
                <Button fx:id="btnSubscribe"
                        text="Subscribe"
                        onAction="#subscribeClass"/>

            </HBox>

        </VBox>

    </children>

</AnchorPane>